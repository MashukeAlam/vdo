    {
      "id": "scene_3",
      "type": "ArchitectureFlow",
      "narration": "With modern distributed tools like LiteFS and Turso, write-ahead logs replicate continuously to worldwide edge instances. Your app reads locally with zero latency, while writes synchronize seamlessly.",
      "props": {
        "title": "Global Edge Replication Flow",
        "steps": [
          {
            "title": "Edge HTTP Request",
            "desc": "User hits Tokyo or London edge server",
            "icon": "server"
          },
          {
            "title": "In-Process Read",
            "desc": "SQLite reads local replica in 20 microseconds",
            "icon": "cpu"
          },
          {
            "title": "LiteFS WAL Sync",
            "desc": "Write-ahead logs stream async across cluster",
            "icon": "cloud"
          },
          {
            "title": "Instant Consensus",
            "desc": "Primary node commits globally with zero lockup",
            "icon": "check"
          }
        ],
        "activeStepIndex": 1
