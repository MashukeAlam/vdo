        "title": "THE N+1 EXPLOSION",
        "badge": "PRODUCTION METRICS",
        "highlightWord": "EXPLOSION",
        "underlineColor": "#f43f5e",
        "leftPane": {
          "title": "ORM: fetch_users.py",
          "lines": [
            {
              "lineNum": "1",
              "text": "users = User.query.all()"
            },
            {
              "lineNum": "2",
              "text": "for u in users:"
            },
            {
              "lineNum": "3",
              "text": "  print(u.profile.bio)"
            }
          ],
          "caption": "Innocent Application Code",
          "stickFigure": {
