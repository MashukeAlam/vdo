    {
      "id": "scene_3",
      "type": "CodeExplainer",
      "narration": "The fix is eager loading. Using select related or prefetch tells the database to fetch relational data in bulk, replacing a hundred roundtrips with a single fast join.",
      "props": {
        "language": "python",
        "filename": "optimized_query.py",
        "code": "# \u274c BAD: Triggers N+1 Queries\nusers = User.query.all()\nfor user in users:\n    print(user.profile.bio)\n\n# \u2705 FAST: Eager Loading with JOIN\nusers = User.query.options(\n    joinedload(User.profile)\n).all()",
        "highlightLines": [
          7,
          8,
          9
        ],
        "lineNotes": [
          {
            "line": 2,
            "note": "Spams a query per loop iteration"
          },
          {
            "line": 7,
            "note": "Eager loads profile in 1 single JOIN query"
          }
        ]
      },
