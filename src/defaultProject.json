    {
      "id": "scene_2",
      "type": "TerminalSplit",
      "narration": "Traditional client-server databases spend ninety percent of their query time on network hops, TLS handshakes, and connection pools. SQLite runs inside your process, executing queries in twenty microseconds flat.",
      "props": {
        "title": "NETWORK HOP TAX",
        "badge": "LATENCY BREAKDOWN",
        "highlightWord": "TAX",
        "underlineColor": "#f43f5e",
        "leftPane": {
          "title": "Cloud RDS (Postgres / MySQL)",
          "lines": [
            {
              "lineNum": "1",
              "text": "App -> DNS & TLS Handshake: 4ms",
              "type": "drift"
            },
            {
              "lineNum": "2",
              "text": "TCP Wire Serialization: 3ms",
              "type": "drift"
            },
            {
              "lineNum": "3",
              "text": "Query Execution: 1ms"
            },
            {
              "lineNum": "!",
              "text": "TOTAL LATENCY = 8.0ms",
              "type": "drift"
            }
          ],
          "caption": "90% of time spent on network wire",
          "stickFigure": {
            "pose": "confused",
            "label": "Waiting on Network Socket..."
          }
        },
        "rightPane": {
          "title": "Embedded SQLite (In-Process)",
          "lines": [
            {
              "lineNum": "1",
              "text": "App -> C Function Call: 0ms"
            },
            {
              "lineNum": "2",
              "text": "Direct Memory-Mapped Read: 20\u00b5s"
            },
            {
              "lineNum": "3",
              "text": "Zero Wire Serialization: 0ms"
            },
            {
              "lineNum": "\u2605",
              "text": "TOTAL LATENCY = 0.02ms (400x FASTER)"
            }
          ],
          "caption": "Direct memory pointer access",
          "stickFigure": {
            "pose": "celebrating",
            "label": "Instant 0.02ms Response!"
          }
        },
        "bottomText": "400X FASTER: ZERO NETWORK LATENCY!",
        "bottomSubtext": "Eliminating network roundtrips beats any query index optimization."
      },
