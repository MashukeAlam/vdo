    {
      "id": "scene_2",
      "type": "TerminalSplit",
      "narration": "At 2 a.m., an engineer SSHs into production and manually patches a container. Git thinks there are 3 replicas, but live prod has 7. That is configuration drift.",
      "props": {
        "title": "DRIFT",
        "badge": "STEP 1: THE MANUAL PATCH",
        "highlightWord": "DRIFT",
        "underlineColor": "#f43f5e",
        "cluster": {
          "title": "PROD CLUSTER",
          "badge": "DRIFT DETECTED",
          "nodes": [
            { "name": "node-1", "pods": [{ "id": "1", "color": "#06b6d4" }, { "id": "2", "color": "#06b6d4" }] },
            { "name": "node-2", "pods": [{ "id": "3", "color": "#8b5cf6" }, { "id": "4", "color": "#8b5cf6" }] },
            { "name": "node-3", "pods": [{ "id": "5", "color": "#f43f5e" }, { "id": "6", "color": "#f43f5e" }] }
          ]
        },
        "leftPane": {
          "title": "git: deploy.yaml",
          "lines": [
            { "lineNum": "1", "text": "kind: Deployment" },
            { "lineNum": "2", "text": "replicas: 3", "type": "normal" },
            { "lineNum": "3", "text": "image: app:v1.4.2" },
            { "lineNum": "4", "text": "env: (none)" }
          ],
          "caption": "Intended Git State",
          "stickFigure": {
            "pose": "laptop-night",
            "label": "① SSH @ 2am"
          }
        },
        "rightPane": {
          "title": "kubectl get -o yaml",
          "lines": [
            { "lineNum": "1", "text": "kind: Deployment" },
            { "lineNum": "!", "text": "replicas: 7 <- drift", "type": "drift" },
            { "lineNum": "!", "text": "image: app:v1.4.1", "type": "drift" },
            { "lineNum": "!", "text": "env: PATCHED", "type": "drift" }
          ],
          "caption": "Live Production State",
          "stickFigure": {
            "pose": "standing",
            "label": "② kubectl edit"
          }
        },
        "bottomText": "AND NOBODY KNOWS...",
        "bottomSubtext": "Until the next deployment crashes production."
      }
    },
    {
      "id": "scene_3",
