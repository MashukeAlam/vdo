  "scenes": [
    {
      "id": "scene_1",
      "type": "TitleCard",
      "narration": "Why does GitOps even exist? CD was already solved by Jenkins and GitHub Actions. Here is the dirty secret.",
      "props": {
        "title": "Why Does GitOps Even Exist?",
        "subtitle": "Continuous Deployment was solved... until 2 AM SSH happened",
        "badge": "DEVOPS ARCHITECTURE",
        "tags": ["GitOps", "Kubernetes", "DevOps", "CloudNative"]
      }
